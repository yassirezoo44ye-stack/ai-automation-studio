# SocialPilot AI — environment configuration
# Copy to `.env` and fill in real values. Never commit the real `.env`.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Database (docker-compose's `postgres` service, or your own Postgres 16)
# ---------------------------------------------------------------------------
POSTGRES_USER=socialpilot
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=socialpilot
# Used directly by the backend; must match the three POSTGRES_* values above
# when running via docker-compose (host "postgres" is the compose service name).
DATABASE_URL=postgresql+asyncpg://socialpilot:change-me-to-a-strong-password@postgres:5432/socialpilot

# ---------------------------------------------------------------------------
# Redis (queue backend from Phase 3 onward; also used for rate-limit storage)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Auth / JWT
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------
# Set to false only for plain-http local development. Must be true in any
# environment served over https (the app refuses to boot with this false
# when ENVIRONMENT=production).
COOKIE_SECURE=true
COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
AUTH_RATE_LIMIT=10/minute
AI_GENERATION_RATE_LIMIT=20/minute
# Optional: overrides REDIS_URL as the slowapi storage backend if you want a
# separate Redis instance/DB index for rate-limit counters.
RATE_LIMIT_STORAGE_URL=

# ---------------------------------------------------------------------------
# AI provider (Phase 2: content strategy + generation). Provider abstraction
# lives in backend/app/services/ai/ — no functionality is faked when
# AI_API_KEY is unset, content generation simply refuses to run (503) until a
# real key is provided. Currently supported: AI_PROVIDER=anthropic.
#
# AI_PROVIDER=mock is a separate, deterministic, network-free provider used
# only for local development without a key, CI, and end-to-end tests — the
# app refuses to boot with it when ENVIRONMENT=production.
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Object storage (Phase 5+: media library). "local" stores under a mounted
# volume for development; "s3" requires the S3_* values below.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Social platform OAuth (Phase 4+). Each provider is its own module under
# backend/app/providers/social/ and is inert until its credentials are set —
# no platform is "connected" by default. Fill in only the platforms you have
# App Review / developer access for.
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Frontend (baked into the static build — see frontend/Dockerfile)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
